{
  "name": "dsh-trellis-sun",
  "version": "1.1.0",
  "description": "Self-contained Trellis workflow trigger for DeepSeek Harness: per-turn breadcrumb injection via agent/pre-step, a bundled skill provider, and DSH-native task/phase state resolution. No Trellis AGPL code is vendored; workflow semantics are rewritten and licensed MIT.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "bin": {
    "sun-trellis-install": "./scripts/install.mjs"
  },
  "scripts": {
    "test": "node --test",
    "install:trellis": "node ./scripts/install.mjs"
  },  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./skills/*": "./skills/*"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "icon.svg",
    "docs/images/architecture.drawio.png",
    "cordis.patch.yml",
    "README_EN.md",
    "FORK.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supersun3757/dsh-trellis-sun.git"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "trellis",
    "workflow"
  ]
}
